<?xml version="1.0" encoding="UTF-8"?>
<!-- Starts the decision server at login and restarts it if it stops (macOS).
     Install: cp assist-decider.plist ~/Library/LaunchAgents/
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/assist-decider.plist
     Remove:  launchctl bootout gui/$(id -u)/assist-decider
     Log:     ~/Library/Logs/assist-decider.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>assist-decider</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/assist-decider" --host 0.0.0.0 --model d1-3b &gt;&gt; "$HOME/Library/Logs/assist-decider.log" 2&gt;&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
